{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bharatspectral-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "CUBES_BUCKET",
      "bucket_name": "bharatspectral-cubes",
      "preview_bucket_name": "bharatspectral-cubes-preview"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
